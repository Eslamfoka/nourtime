    <!-- Permissions -->
    <string name="perm_accessibility_title">خدمة إمكانية الوصول</string>
    <string name="perm_accessibility_short">تعرف التطبيقات الظاهرة على الشاشة (بما فيها الصورة داخل الصورة وتقسيم الشاشة) حتى لا يعمل المؤقت إلا أثناء استخدام تطبيق مختار. لا تقرأ أبدًا ما يظهر على الشاشة.</string>
    <string name="perm_accessibility_why">يستخدم وقت نور خدمة إمكانية الوصول فقط لمعرفة التطبيقات الظاهرة على الشاشة، بما فيها نوافذ الصورة داخل الصورة الصغيرة وتقسيم الشاشة. من كل نافذة يقرأ اسم التطبيق الذي يملكها فقط، ولا يقرأ أبدًا النصوص أو الصور أو أي محتوى يظهر داخل التطبيقات، ولا ما يكتبه طفلك. بهذا يعمل المؤقت فقط أثناء استخدام تطبيق مختار، وتظهر شاشة \"خلص الوقت\" في اللحظة المناسبة. ما تعرفه الخدمة يبقى على هذا الهاتف، وإذا ربطت هاتفك يُشارَك معك فقط الوقت المتبقي ودقائق الاستخدام.</string>
    <string name="perm_accessibility_how">في الإعدادات، افتح \"التطبيقات المثبتة\" (أو \"التطبيقات التي تم تنزيلها\")، ثم اضغط على وقت نور وفعّله.</string>
    <string name="perm_accessibility_how_honor">في صفحة إمكانية الوصول، مرّر للأسفل: ستجد وقت نور في القائمة. اضغط عليه وفعّله.</string>
    <string name="perm_accessibility_restricted">هل المفتاح باهت ولا يعمل؟ في أندرويد ١٣ وما بعده: افتح معلومات التطبيق، واضغط قائمة ⋮، واختر \"السماح بالإعدادات المقيدة\"، ثم حاول مرة أخرى.</string>
    <string name="perm_open_app_info">افتح معلومات التطبيق</string>

    <string name="perm_usage_title">الوصول إلى بيانات الاستخدام</string>
    <string name="perm_usage_short">طريقة احتياطية لمعرفة التطبيق المفتوح، ومصدر إحصاءات الاستخدام اليومية.</string>
    <string name="perm_usage_why">يستخدم وقت نور هذا الإذن كطريقة احتياطية لمعرفة التطبيق الظاهر على الشاشة، وليعرض لك مدة استخدام كل تطبيق اليوم. تبقى هذه المعلومات على هذا الهاتف إلا إذا ربطت هاتفك، وعندها تُشارَك معك دقائق استخدام كل تطبيق محدد.</string>
    <string name="perm_usage_how">ابحث عن وقت نور في القائمة وفعّل \"السماح بالوصول إلى بيانات الاستخدام\".</string>

    <string name="perm_overlay_title">الظهور فوق التطبيقات الأخرى</string>
    <string name="perm_overlay_short">يعرض شاشة \"خلص الوقت\" اللطيفة فوق التطبيقات المختارة.</string>
    <string name="perm_overlay_why">عندما ينتهي الوقت، يعرض وقت نور شاشة \"خلص الوقت\" اللطيفة فوق التطبيقات المختارة. يحتاج أندرويد إلى هذا الإذن للسماح بذلك.</string>
    <string name="perm_overlay_how">فعّل \"السماح بالظهور فوق التطبيقات الأخرى\" لوقت نور.</string>
    <string name="perm_overlay_how_honor">يفتح هذا الهاتف قائمة كل التطبيقات. ابحث عن وقت نور (أو مرّر حتى تجده)، ثم اضغط عليه وفعّل \"السماح بالظهور فوق التطبيقات الأخرى\".</string>

    <string name="perm_admin_title">مشرف الجهاز</string>
    <string name="perm_admin_short">يقفل الشاشة عند انتهاء الوقت ويحمي وقت نور من الحذف.</string>
    <string name="perm_admin_why">يسمح إذن مشرف الجهاز لوقت نور بقفل الشاشة عند انتهاء الوقت، ويمنع إلغاء تثبيت التطبيق دون رمزك. لا يستطيع وقت نور قراءة بياناتك أو مسحها بهذا الإذن.</string>
    <string name="perm_admin_how">اضغط \"تفعيل\" في الشاشة التالية.</string>
    <string name="perm_admin_explanation">يقفل الشاشة عند انتهاء وقت طفلك، ويحمي وقت نور من الحذف دون رمز الأهل.</string>

    <string name="perm_notif_title">الإشعارات</string>
    <string name="perm_notif_short">يعرض أندرويد إشعارًا صغيرًا أثناء عمل وقت نور في الخلفية.</string>
    <string name="perm_notif_why">يتطلب أندرويد إشعارًا صغيرًا صامتًا أثناء حماية وقت نور للجهاز في الخلفية. لا يرسل وقت نور أي إعلانات أو إشعارات ترويجية.</string>
    <string name="perm_notif_how">اضغط \"سماح\" عند السؤال.</string>

    <string name="perm_battery_title">تحسين البطارية</string>
    <string name="perm_battery_short">يُبقي المؤقت يعمل بدقة في الخلفية.</string>
    <string name="perm_battery_why">بعض الهواتف توقف التطبيقات في الخلفية لتوفير البطارية. السماح لوقت نور بالعمل دون قيود يُبقي المؤقت دقيقًا. يستهلك وقت نور القليل جدًا من البطارية.</string>
    <string name="perm_battery_how">اضغط \"سماح\" في الرسالة التالية.</string>

    <string name="autostart_title">التشغيل التلقائي</string>
    <string name="autostart_why">قد تمنع هواتف %1$s التطبيقات من العمل تلقائيًا. اسمح لوقت نور بالتشغيل التلقائي لتعود الحماية بعد إعادة تشغيل الهاتف.</string>
    <string name="autostart_how">في الشاشة التي ستفتح، فعّل وقت نور. إن لم تفتح، ابحث عن \"التشغيل التلقائي\" أو \"تشغيل التطبيقات\" في إعدادات الهاتف.</string>
    <string name="autostart_how_xiaomi">في الشاشة التي ستفتح، فعّل التشغيل التلقائي لوقت نور. ثم افتح الإعدادات ← التطبيقات ← وقت نور ← توفير البطارية واختر \"بلا قيود\".</string>
    <string name="autostart_how_oppo">في الشاشة التي ستفتح، فعّل وقت نور. في الهواتف الأحدث تجد ذلك عادةً في معلومات التطبيق ← استخدام البطارية: فعّل \"السماح بالتشغيل التلقائي\" و\"السماح بالنشاط في الخلفية\".</string>
    <string name="autostart_how_vivo">في الشاشة التي ستفتح، فعّل وقت نور. ثم تحقق من الإعدادات ← البطارية ← استهلاك الطاقة في الخلفية واسمح لوقت نور.</string>
    <string name="autostart_how_honor_huawei">في \"تشغيل التطبيقات\"، ابحث عن وقت نور، واختر \"الإدارة يدويًا\" وفعّل المفاتيح الثلاثة (التشغيل التلقائي، التشغيل الثانوي، العمل في الخلفية).</string>
    <string name="autostart_how_oneplus">في الشاشة التي ستفتح، فعّل وقت نور. ثم في معلومات التطبيق ← البطارية، اسمح بالنشاط في الخلفية (\"عدم التحسين\").</string>
    <string name="autostart_title_samsung">أبقِ وقت نور مستيقظًا</string>
    <string name="autostart_why_samsung">تضع هواتف سامسونج التطبيقات التي تظنها غير مستخدمة في وضع السكون. أبقِ وقت نور مستيقظًا حتى تستمر الحماية.</string>
    <string name="autostart_how_samsung">في البطارية ← حدود الاستخدام في الخلفية، تأكد أن وقت نور ليس ضمن \"التطبيقات النائمة\" أو \"التطبيقات في سبات عميق\"، وأضفه إلى \"التطبيقات التي لا تنام أبدًا\".</string>
    <string name="autostart_done">قمت بتفعيله</string>
