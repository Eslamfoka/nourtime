    <!-- Welcome -->
    <string name="welcome_title">أهلاً، أنا نور!</string>
    <string name="welcome_body">يساعد وقت نور طفلك على الاستمتاع بالشاشة بقدر صحي. أنت تختار التطبيقات والوقت، وعندما ينتهي الوقت تخبر نور طفلك بلطف أنه حان وقت شيء آخر.</string>
    <string name="welcome_point_budget">رصيد وقت واحد مشترك للتطبيقات التي تختارها</string>
    <string name="welcome_point_lock">قفل تلقائي عند انتهاء الوقت</string>
    <string name="welcome_point_private">خصوصية: لا يُشارَك شيء إلا إذا ربطت هاتفك</string>
    <string name="welcome_cta">لنبدأ</string>

    <!-- Prominent disclosure -->
    <string name="disclosure_title">ما يحتاجه وقت نور ولماذا</string>
    <string name="disclosure_intro">وقت نور تطبيق للرقابة الأبوية. ليحدّ من وقت طفلك على التطبيقات التي تختارها، يحتاج إلى الأذونات التالية. لا يقرأ وقت نور أبدًا ما يظهر على الشاشة، ولا يحتوي على إعلانات أو تتبّع. لا يخرج شيء من هذا الهاتف إلا إذا ربطت هاتفك أنت كولي أمر، وعندها يُشارَك مع حسابك في Google فقط الوقت المتبقي، ودقائق استخدام كل تطبيق، وقائمة التطبيقات، وإعدادات وقت نور.</string>
    <string name="disclosure_footer">ستمنح كل إذن بنفسك، واحدًا تلو الآخر، ويمكنك إيقاف أي منها لاحقًا من إعدادات الهاتف.</string>
    <string name="disclosure_accept">أوافق، متابعة</string>
    <string name="disclosure_decline">ليس الآن</string>

