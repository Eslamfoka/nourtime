    <!-- Security question -->
    <string name="sq_title">سؤال الأمان</string>
    <string name="sq_body">إذا عرف طفلك الرمز يومًا ما، سيُبقي هذا السؤال التطبيقات المختارة والإعدادات مغلقة خلال فترة القفل. اكتب سؤالًا لا يعرف إجابته غيرك.</string>
