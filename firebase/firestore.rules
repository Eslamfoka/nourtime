rules_version = '2';

// Nour Time Phase 2 (remote control). The child's phone signs in anonymously and owns
// devices/{id}; a parent signed in with Google claims a short-lived pairing code, and the child's
// phone confirms by writing ownerUid. See docs/superpowers/plans/2026-09-27-phase2-remote-control.md.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isGoogle() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // A device document: the fields the phones write (a few spare for older versions), a short name.
    function deviceSizeOk() {
      return request.resource.data.size() <= 24
        && (!('name' in request.resource.data)
          || (request.resource.data.name is string && request.resource.data.name.size() <= 100));
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function device(id) {
      return get(/databases/$(database)/documents/devices/$(id)).data;
    }

    function isChildOf(id) {
      return signedIn() && device(id).childUid == request.auth.uid;
    }

    function isOwnerOf(id) {
      return signedIn() && device(id).ownerUid == request.auth.uid;
    }

    function pairing(code) {
      return get(/databases/$(database)/documents/pairings/$(code)).data;
    }

    function childAccountAfter() {
      return getAfter(/databases/$(database)/documents/childAccounts/$(request.auth.uid)).data;
    }

    // After this write, the code's pairing is gone or isn't this account's (the TTL deleted it and
    // another phone made the same code since).
    function codeGoneAfter(code) {
      return !existsAfter(/databases/$(database)/documents/pairings/$(code))
        || getAfter(/databases/$(database)/documents/pairings/$(code)).data.childUid != request.auth.uid;
    }

    // After this write, the device is gone or isn't this account's. A device's childUid never
    // changes, so one that names another account was never this account's: moving the record off it
    // frees nothing, and the one-device limit holds (2026-10-28 review: a record naming such a device
    // refused the phone every new code for good).
    function deviceGoneAfter(id) {
      return !existsAfter(/databases/$(database)/documents/devices/$(id))
        || getAfter(/databases/$(database)/documents/devices/$(id)).data.childUid != request.auth.uid;
    }

    // usage/{day}: a date close to now (today and yesterday on any time zone, a week for a phone that
    // was off), so a phone can't make day documents without limit.
    function recentDay(day) {
      let parts = day.split('-');
      return day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && timestamp.date(int(parts[0]), int(parts[1]), int(parts[2])) > request.time - duration.value(8, 'd')
        && timestamp.date(int(parts[0]), int(parts[1]), int(parts[2])) < request.time + duration.value(2, 'd');
    }

    // The child's phone may keep its owner, clear it, or set it to the parent who claimed one of
    // its codes (named in pairingCode). Nobody can be made the owner of a phone they didn't claim.
    function ownerChangeAllowed(id) {
      let newOwner = request.resource.data.get('ownerUid', null);
      let code = request.resource.data.get('pairingCode', '');
      return newOwner == resource.data.get('ownerUid', null)
        || newOwner == null
        || (code is string && code.matches('^[0-9]{6}$')
          && exists(/databases/$(database)/documents/pairings/$(code))
          && pairing(code).deviceId == id
          && pairing(code).claimedBy == newOwner);
    }

    // Pairing codes, valid 10 minutes from createdAt (server time, so the phone's clock doesn't
    // matter). Claiming one does nothing until the child's phone confirms.
    match /pairings/{code} {
      // Only the child's phone that made a code and the parent who claimed it can read it: a parent
      // claims blind, so no one can look codes up to learn other phones' ids or claim them first
      // (2026-10-17 audit). A child's phone (not a Google account) may learn that a code is free.
      allow get: if signedIn()
        && ((resource == null && !isGoogle())
          || resource.data.childUid == request.auth.uid
          || resource.data.claimedBy == request.auth.uid);
      allow list: if false;

      // expireAt is for the Firestore TTL policy that deletes abandoned codes (README); it may be up to
      // 2 days away but never shorter than a code's 10 minutes.
      allow create: if signedIn()
        && code.matches('^[0-9]{6}$')
        && request.resource.data.keys().hasOnly(['deviceId', 'childUid', 'createdAt', 'expireAt', 'claimedBy', 'claimedEmail', 'claimedName'])
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt > request.time + duration.value(10, 'm')
        && request.resource.data.expireAt < request.time + duration.value(2, 'd')
        && request.resource.data.childUid == request.auth.uid
        && request.resource.data.claimedBy == null
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/devices/$(request.resource.data.deviceId))
        && device(request.resource.data.deviceId).childUid == request.auth.uid
        // One open code per account: the code is named in childAccounts/{uid} in the same write.
        && childAccountAfter().get('openCode', null) == code;

      allow update: if isGoogle()
        && resource.data.claimedBy == null
        && request.time < resource.data.createdAt + duration.value(10, 'm')
        && changedOnly(['claimedBy', 'claimedEmail', 'claimedName'])
        && request.resource.data.claimedBy == request.auth.uid
        // The name shown on the child's phone must be the signed-in account's own.
        && request.auth.token.email_verified == true
        && request.resource.data.claimedEmail == request.auth.token.email
        && (request.resource.data.claimedName == null
          || (request.resource.data.claimedName is string && request.resource.data.claimedName.size() <= 100));

      allow delete: if signedIn() && resource.data.childUid == request.auth.uid;
    }

    match /devices/{id} {
      // A missing device can be "read" (it reveals nothing), so the child's phone can check
      // whether its device exists before creating it.
      allow get: if signedIn()
        && (resource == null || resource.data.childUid == request.auth.uid || resource.data.ownerUid == request.auth.uid);
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // One device per account: the one childAccounts/{uid} names, written together with it.
      allow create: if signedIn()
        && request.resource.data.childUid == request.auth.uid
        && request.resource.data.ownerUid == null
        && request.resource.data.keys().hasOnly(['childUid', 'ownerUid', 'ownerEmail', 'ownerName', 'name', 'createdAt'])
        && deviceSizeOk()
        && childAccountAfter().deviceId == id;

      // The child's phone writes everything but its own identity; the owner writes only the
      // settings, or removes itself.
      allow update: if signedIn() && (
        (resource.data.childUid == request.auth.uid
          && request.resource.data.childUid == resource.data.childUid
          && deviceSizeOk()
          && ownerChangeAllowed(id))
        || (resource.data.ownerUid == request.auth.uid
          && (changedOnly(['settings'])
            || (changedOnly(['ownerUid', 'ownerEmail', 'ownerName']) && request.resource.data.ownerUid == null)))
      );

      // Account deletion: the child's phone removes its device (after its subcollections, which
      // the rules check against this document).
      allow delete: if signedIn() && resource.data.childUid == request.auth.uid;

      // Minutes per limited app for one day: {ms: {package: ms}, updatedAt}.
      match /usage/{day} {
        allow read: if isChildOf(id) || isOwnerOf(id);
        allow create, update: if isChildOf(id)
          && recentDay(day)
          && request.resource.data.keys().hasOnly(['ms', 'updatedAt'])
          && request.resource.data.ms is map
          && request.resource.data.ms.size() <= 500;
        // Old days are pruned whatever their date.
        allow delete: if isChildOf(id);
      }

      // The app list (apps) and the protection alerts (alerts); nothing else.
      match /meta/{docId} {
        allow read: if isChildOf(id) || isOwnerOf(id);
        allow create, update: if isChildOf(id)
          && docId in ['apps', 'alerts']
          && request.resource.data.size() <= 30
          && (docId != 'apps' || (request.resource.data.apps is list && request.resource.data.apps.size() <= 2000));
        allow delete: if isChildOf(id);
      }

      // A child's request for more time (Phase 4c): asked by the child, answered once by the owner.
      match /requests/{requestId} {
        allow read: if isChildOf(id) || isOwnerOf(id);

        allow create: if isChildOf(id)
          && request.resource.data.keys().hasOnly(['status', 'createdAt'])
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;

        allow update: if isOwnerOf(id)
          && resource.data.status == 'pending'
          && changedOnly(['status', 'minutes', 'answeredAt', 'by'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.answeredAt == request.time
          && (
            (request.resource.data.status == 'approved'
              && request.resource.data.minutes is int
              && request.resource.data.minutes >= 1
              && request.resource.data.minutes <= 240)
            || (request.resource.data.status == 'declined' && !('minutes' in request.resource.data))
          );

        allow delete: if isChildOf(id);
      }

      match /commands/{commandId} {
        allow read: if isChildOf(id) || isOwnerOf(id);

        allow create: if isOwnerOf(id)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.appliedAt == null
          && (
            (request.resource.data.type == 'BONUS'
              && request.resource.data.keys().hasOnly(['type', 'minutes', 'createdAt', 'by', 'appliedAt'])
              && request.resource.data.minutes is int
              && request.resource.data.minutes >= 1
              && request.resource.data.minutes <= 240)
            || (request.resource.data.type in ['LOCK_NOW', 'END_LOCK', 'APPROVE_PIN_RESET']
              && request.resource.data.keys().hasOnly(['type', 'createdAt', 'by', 'appliedAt']))
          );

        // Applied exactly once, by the child's phone.
        allow update: if isChildOf(id)
          && resource.data.appliedAt == null
          && changedOnly(['appliedAt'])
          && request.resource.data.appliedAt != null;

        // Account deletion: the child's phone clears all of them; a parent clears the ones it sent.
        allow delete: if isChildOf(id) || (isOwnerOf(id) && resource.data.by == request.auth.uid);
      }
    }

    // A child's phone account: its one device and its one open pairing code (2026-10-28 audit: any
    // account, also an anonymous one, could make devices and codes without limit; codes are only a
    // million, so that could have used them up). Moving to another device or code needs the old one
    // gone in the same write.
    match /childAccounts/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;

      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['deviceId', 'openCode'])
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() <= 64
        && (request.resource.data.get('openCode', null) == null
          || (request.resource.data.openCode is string && request.resource.data.openCode.matches('^[0-9]{6}$')))
        && (resource == null
          || resource.data.deviceId == request.resource.data.deviceId
          || deviceGoneAfter(resource.data.deviceId))
        && (resource == null
          || resource.data.get('openCode', null) == null
          || resource.data.openCode == request.resource.data.get('openCode', null)
          || codeGoneAfter(resource.data.openCode));

      // With the account: once its device and code are gone.
      allow delete: if signedIn() && request.auth.uid == uid
        && deviceGoneAfter(resource.data.deviceId)
        && (resource.data.get('openCode', null) == null || codeGoneAfter(resource.data.openCode));
    }

    // FCM tokens of a parent's phones (one document per token, id = token).
    match /parents/{uid}/tokens/{token} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['createdAt', 'platform'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.platform == 'android';
    }

    // When each push type was last sent for a device: Cloud Functions only.
    match /pushState/{deviceId} {
      allow read, write: if false;
    }
  }
}
