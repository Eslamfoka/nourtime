rules_version = '2';

// Nour Time Phase 2 (remote control). The child's phone signs in anonymously and owns
// devices/{id}; a parent signed in with Google claims a short-lived pairing code, and the child's
// phone confirms by writing ownerUid. See docs/superpowers/plans/2026-09-27-phase2-remote-control.md.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isGoogle() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function device(id) {
      return get(/databases/$(database)/documents/devices/$(id)).data;
    }

    function isChildOf(id) {
      return signedIn() && device(id).childUid == request.auth.uid;
    }

    function isOwnerOf(id) {
      return signedIn() && device(id).ownerUid == request.auth.uid;
    }

    function pairing(code) {
      return get(/databases/$(database)/documents/pairings/$(code)).data;
    }

    // The child's phone may keep its owner, clear it, or set it to the parent who claimed one of
    // its codes (named in pairingCode). Nobody can be made the owner of a phone they didn't claim.
    function ownerChangeAllowed(id) {
      let newOwner = request.resource.data.get('ownerUid', null);
      let code = request.resource.data.get('pairingCode', '');
      return newOwner == resource.data.get('ownerUid', null)
        || newOwner == null
        || (code is string && code.matches('^[0-9]{6}$')
          && exists(/databases/$(database)/documents/pairings/$(code))
          && pairing(code).deviceId == id
          && pairing(code).claimedBy == newOwner);
    }

    // Pairing codes, valid 10 minutes from createdAt (server time, so the phone's clock doesn't
    // matter). Claiming one does nothing until the child's phone confirms.
    match /pairings/{code} {
      // Parents (Google) look codes up; a child's phone only reads its own (or learns a code is free).
      allow get: if signedIn()
        && (resource == null || isGoogle() || resource.data.childUid == request.auth.uid);
      allow list: if false;

      // expireAt is for the Firestore TTL policy that deletes abandoned codes (README); it may be up to
      // 2 days away but never shorter than a code's 10 minutes.
      allow create: if signedIn()
        && code.matches('^[0-9]{6}$')
        && request.resource.data.keys().hasOnly(['deviceId', 'childUid', 'createdAt', 'expireAt', 'claimedBy', 'claimedEmail', 'claimedName'])
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt > request.time + duration.value(10, 'm')
        && request.resource.data.expireAt < request.time + duration.value(2, 'd')
        && request.resource.data.childUid == request.auth.uid
        && request.resource.data.claimedBy == null
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/devices/$(request.resource.data.deviceId))
        && device(request.resource.data.deviceId).childUid == request.auth.uid;

      allow update: if isGoogle()
        && resource.data.claimedBy == null
        && request.time < resource.data.createdAt + duration.value(10, 'm')
        && changedOnly(['claimedBy', 'claimedEmail', 'claimedName'])
        && request.resource.data.claimedBy == request.auth.uid
        // The name shown on the child's phone must be the signed-in account's own.
        && request.auth.token.email_verified == true
        && request.resource.data.claimedEmail == request.auth.token.email
        && (request.resource.data.claimedName == null
          || (request.resource.data.claimedName is string && request.resource.data.claimedName.size() <= 100));

      allow delete: if signedIn() && resource.data.childUid == request.auth.uid;
    }

    match /devices/{id} {
      // A missing device can be "read" (it reveals nothing), so the child's phone can check
      // whether its device exists before creating it.
      allow get: if signedIn()
        && (resource == null || resource.data.childUid == request.auth.uid || resource.data.ownerUid == request.auth.uid);
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.childUid == request.auth.uid
        && request.resource.data.ownerUid == null;

      // The child's phone writes everything but its own identity; the owner writes only the
      // settings, or removes itself.
      allow update: if signedIn() && (
        (resource.data.childUid == request.auth.uid
          && request.resource.data.childUid == resource.data.childUid
          && ownerChangeAllowed(id))
        || (resource.data.ownerUid == request.auth.uid
          && (changedOnly(['settings'])
            || (changedOnly(['ownerUid', 'ownerEmail', 'ownerName']) && request.resource.data.ownerUid == null)))
      );

      // Account deletion: the child's phone removes its device (after its subcollections, which
      // the rules check against this document).
      allow delete: if signedIn() && resource.data.childUid == request.auth.uid;

      match /usage/{day} {
        allow read: if isChildOf(id) || isOwnerOf(id);
        allow write: if isChildOf(id);
      }

      match /meta/{docId} {
        allow read: if isChildOf(id) || isOwnerOf(id);
        allow write: if isChildOf(id);
      }

      match /commands/{commandId} {
        allow read: if isChildOf(id) || isOwnerOf(id);

        allow create: if isOwnerOf(id)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.appliedAt == null
          && (
            (request.resource.data.type == 'BONUS'
              && request.resource.data.keys().hasOnly(['type', 'minutes', 'createdAt', 'by', 'appliedAt'])
              && request.resource.data.minutes is int
              && request.resource.data.minutes >= 1
              && request.resource.data.minutes <= 240)
            || (request.resource.data.type in ['LOCK_NOW', 'END_LOCK']
              && request.resource.data.keys().hasOnly(['type', 'createdAt', 'by', 'appliedAt']))
          );

        // Applied exactly once, by the child's phone.
        allow update: if isChildOf(id)
          && resource.data.appliedAt == null
          && changedOnly(['appliedAt'])
          && request.resource.data.appliedAt != null;

        // Account deletion: the child's phone clears all of them; a parent clears the ones it sent.
        allow delete: if isChildOf(id) || (isOwnerOf(id) && resource.data.by == request.auth.uid);
      }
    }
  }
}
